# ============================================================================
# Generic macOS Build System Configuration
# ============================================================================
# Copy this file to .env and customize for your project

# ----------------------------------------------------------------------------
# PROJECT CONFIGURATION (Required)
# ----------------------------------------------------------------------------

# Xcode project file name (without .xcodeproj extension)
PROJECT_NAME=SwipeSimulator

# Main build scheme name
SCHEME_NAME=SensibleSideButtons

# App bundle name (e.g., MyApp.app)
APP_NAME=SensibleSideButtons.app

# Path to Info.plist (relative to project root)
INFO_PLIST_PATH=SideButtonFixer/Info.plist

# ----------------------------------------------------------------------------
# GITHUB CONFIGURATION (Required for releases)
# ----------------------------------------------------------------------------

# GitHub repository owner/username
GITHUB_OWNER=<USERNAME>

# GitHub repository name
GITHUB_REPO=sensible-side-buttons

# GitHub repository URL (without https://)
GITHUB_URL=github.com/${GITHUB_OWNER}/${GITHUB_REPO}

# ----------------------------------------------------------------------------
# NOTARIZATION CONFIGURATION (Required for notarization)
# ----------------------------------------------------------------------------

# Keychain profile name for notarization credentials
# Create with: xcrun notarytool store-credentials PROFILE_NAME
NOTARIZATION_KEYCHAIN_PROFILE=<PROFILE>

# Alternative: Direct credentials (less secure, not recommended)
# NOTARIZATION_APPLE_ID=your-email@example.com
# NOTARIZATION_TEAM_ID=YOUR_TEAM_ID
# NOTARIZATION_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ----------------------------------------------------------------------------
# CODE SIGNING (Optional - auto-detected if not specified)
# ----------------------------------------------------------------------------

# Development certificate (for debug builds)
# If not specified, will use first "Apple Development" certificate found
# DEV_SIGNING_IDENTITY="Apple Development: Your Name (TEAM_ID)"

# Distribution certificate (for release/notarization)
# If not specified, will use first "Developer ID Application" certificate found
# DIST_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"

# Team ID (optional - extracted from certificate if not specified)
# DEVELOPMENT_TEAM=<YOUR_TEAM_ID>

# ----------------------------------------------------------------------------
# BUILD CONFIGURATION (Optional - sensible defaults provided)
# ----------------------------------------------------------------------------

# Build output directory (relative to project root)
BUILD_DIR=./build

# Architectures to build (space-separated)
# Default: arm64 x86_64 (universal binary)
BUILD_ARCHS="arm64 x86_64"

# Minimum macOS deployment target (optional - uses project setting if not set)
# MACOSX_DEPLOYMENT_TARGET=11.0

# ----------------------------------------------------------------------------
# DISTRIBUTION CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# DMG volume name (defaults to app name without .app)
# DMG_VOLUME_NAME="SensibleSideButtons"

# DMG file name pattern (uses version from Info.plist)
# DMG_NAME_PATTERN="${APP_NAME_NO_EXT}-\${VERSION}.dmg"

# Project homepage URL (for documentation/cask)
PROJECT_HOMEPAGE=https://sensible-side-buttons.archagon.net

# Project description (short, for Homebrew cask)
PROJECT_DESCRIPTION="Makes side mouse buttons perform swipe gestures for navigation"

# ----------------------------------------------------------------------------
# RELEASE NOTES CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# Path to custom release notes template (optional)
# RELEASE_NOTES_TEMPLATE=.github/RELEASE_TEMPLATE.md

# Changelog comparison base version (optional)
# CHANGELOG_BASE_VERSION=v1.0.5

# ----------------------------------------------------------------------------
# ADVANCED OPTIONS (Usually don't need to change)
# ----------------------------------------------------------------------------

# Skip cleaning before build by default
# NO_CLEAN_DEFAULT=false

# Verbose build output by default
# VERBOSE_DEFAULT=false

# Wait for notarization to complete (vs background submission)
# NOTARIZATION_WAIT=true

# Enable debug output in build scripts
# DEBUG=false
