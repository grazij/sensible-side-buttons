# ============================================================================
# Generic macOS Build System Configuration
# ============================================================================
# Copy this file to .env and customize for your project.
# Every variable listed here is read by build-config.sh, build.sh, or
# release-github.sh. Do not add variables the scripts do not use.

# ----------------------------------------------------------------------------
# PROJECT CONFIGURATION (Required)
# ----------------------------------------------------------------------------

# Xcode project file name (without .xcodeproj extension)
PROJECT_NAME=SwipeSimulator

# Main build scheme name (must be a shared scheme)
SCHEME_NAME=SensibleSideButtons

# App bundle name (e.g., MyApp.app)
APP_NAME=SensibleSideButtons.app

# Path to Info.plist (relative to project root). Version and build number
# are read from CFBundleShortVersionString and CFBundleVersion here.
INFO_PLIST_PATH=SideButtonFixer/Info.plist

# ----------------------------------------------------------------------------
# NESTED CODE SIGNING (Required for any app embedding frameworks or helpers)
# ----------------------------------------------------------------------------

# Paths inside the .app that must be signed before the app itself, INNERMOST
# FIRST. codesign seals a bundle by hashing its contents, so anything nested
# has to carry its final signature already; otherwise notarization rejects each
# item with "The binary is not signed with a valid Developer ID certificate".
#
# This app embeds no frameworks or helper tools, so the list is empty. Leaving
# it empty on an app that DOES embed any is a silent notarization failure, so
# build.sh refuses to sign an app with a Contents/Frameworks directory unless
# this is set. Example:
#
# NESTED_CODE_PATHS="
# Contents/Frameworks/Some.framework/Versions/A/Helpers/helper
# Contents/Frameworks/Some.framework
# "
NESTED_CODE_PATHS=""

# ----------------------------------------------------------------------------
# GITHUB CONFIGURATION (Used by release-github.sh)
# ----------------------------------------------------------------------------

# Repository owner and name. If either is unset, the URL is derived from
# `git remote get-url origin`.
GITHUB_OWNER=<USERNAME>
GITHUB_REPO=sensible-side-buttons

# ----------------------------------------------------------------------------
# HOMEBREW (Optional - release-github.sh prints the cask SHA256 step if set)
# ----------------------------------------------------------------------------

# HOMEBREW_CASK=sensible-side-buttons

# ----------------------------------------------------------------------------
# NOTARIZATION CONFIGURATION (Required for notarize and package)
# ----------------------------------------------------------------------------

# Keychain profile name for notarization credentials
# Create with: xcrun notarytool store-credentials PROFILE_NAME
NOTARIZATION_KEYCHAIN_PROFILE=<PROFILE>

# Alternative: Direct credentials (less secure, not recommended)
# NOTARIZATION_APPLE_ID=your-email@example.com
# NOTARIZATION_TEAM_ID=YOUR_TEAM_ID
# NOTARIZATION_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ----------------------------------------------------------------------------
# CODE SIGNING (Optional - auto-detected if not specified)
# ----------------------------------------------------------------------------

# Distribution certificate (for sign/notarize)
# If not specified, the first "Developer ID Application" identity is used
# DIST_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"

# ----------------------------------------------------------------------------
# BUILD CONFIGURATION (Optional - sensible defaults provided)
# ----------------------------------------------------------------------------

# Build output directory (relative to project root)
BUILD_DIR=./build

# Architectures to build (space-separated)
# Default: arm64 x86_64 (universal binary)
BUILD_ARCHS="arm64 x86_64"

# ----------------------------------------------------------------------------
# DISTRIBUTION CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# DMG volume name (defaults to app name without .app)
# DMG_VOLUME_NAME="SensibleSideButtons"

# ----------------------------------------------------------------------------
# DEBUGGING
# ----------------------------------------------------------------------------

# Enable debug output in build scripts
# DEBUG=false
